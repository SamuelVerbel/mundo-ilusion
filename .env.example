# =====================================================================
#  MUNDO ILUSIÓN · Configuración (copia este archivo como ".env")
#  Los valores por defecto sirven para XAMPP en tu computador.
#  ⚠️  El archivo ".env" NUNCA se sube a GitHub; solo ".env.example".
# =====================================================================

# ---------- Aplicación ----------
APP_NAME="Mundo Ilusión"
# local      = muestra errores, activa "Simular pago" y la página /diagnostico
# production = oculta todo lo anterior (úsalo cuando la tienda esté en internet)
APP_ENV=local
# URL pública (solo si la tienda ya está en internet). Ej: https://mundoilusion.com
APP_URL=

# ---------- Base de datos (XAMPP: root y sin contraseña) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mundo_ilusion
DB_USER=root
DB_PASS=

# ---------- Correo ----------
# false = los correos se guardan como archivos en storage/mail/ (ideal para desarrollar)
# true  = se envían por SMTP (Gmail: activa verificación en 2 pasos y crea una "contraseña de aplicación")
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME="Mundo Ilusión"

# ---------- Pagos con Wompi (https://comercios.wompi.co) ----------
# sandbox = pruebas | production = dinero real
WOMPI_ENV=sandbox
# Llave pública (empieza por pub_test_ en pruebas). Se puede mostrar.
WOMPI_PUBLIC_KEY=
# SECRETOS: nunca los compartas ni los subas a GitHub
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# ---------- Asistente virtual "Ilu" (chatbot) ----------
# true  = muestra el botón de chat en la tienda. Funciona SIN clave (responde por reglas con datos reales de la tienda).
# Para respuestas con IA agrega una clave: https://console.groq.com/keys (gratis) -> pégala en CHATBOT_API_KEY.
# ⚠️  La clave es un SECRETO: nunca la subas a GitHub ni la pongas en el HTML.
CHATBOT_ENABLED=true
CHATBOT_API_KEY=
# Cualquier API compatible con OpenAI. Por defecto Groq. (OpenAI: https://api.openai.com/v1/chat/completions)
CHATBOT_API_URL=https://api.groq.com/openai/v1/chat/completions
# Los nombres de modelos cambian con el tiempo: si falla, revisa la lista en tu consola del proveedor.
CHATBOT_MODEL=llama-3.3-70b-versatile
CHATBOT_MAX_TOKENS=400
# Máximo de respuestas con IA por día (protege tu cuota gratuita). Al agotarse, sigue por reglas.
CHATBOT_DAILY_LIMIT=400
