# ===== SECRETOS: nunca se suben =====
.env
.env.*
!.env.example
*.pem
*.key

# ===== Datos generados al usar la app (pueden tener datos de clientes) =====
storage/mail/*
storage/logs/*
!storage/mail/.gitkeep
!storage/logs/.gitkeep
public/uploads/productos/*
!public/uploads/productos/.gitkeep

# ===== Copias de bases de datos con información real =====
*.sql.bak
*.dump
backup*/
database/*-real*.sql
database/backup*.sql

# ===== Editor / sistema =====
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
*.tmp

storage/cache/*
!storage/cache/.gitkeep
